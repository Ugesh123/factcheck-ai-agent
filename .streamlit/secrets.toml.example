# Copy to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Community Cloud, paste these into App settings -> Secrets.
OPENROUTER_API_KEY = "sk-or-..."
TAVILY_API_KEY = "tvly-..."

# Optional. Free models only (IDs ending in ":free", or "openrouter/free").
# List several, comma-separated, and OpenRouter tries them in order.
LLM_MODEL = "openrouter/free"
